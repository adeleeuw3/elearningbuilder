{
  "$meta": {
    "name": "Prism Design System",
    "version": "1.0.0",
    "description": "Node-based e-learning app. Light mode, Fluent-geometry, glowy kleurenparen.",
    "mode": "light"
  },
  "color": {
    "pair": {
      "flow": {
        "meaning": "Actief, focus, verbinding, primaire actie",
        "from": "#5AB8FF",
        "to":   "#7DE3FF",
        "ink":  "#0B6FBF",
        "wash": "#EAF6FF",
        "onColor": "#04314F",
        "gradient": "linear-gradient(135deg, #5AB8FF, #7DE3FF)"
      },
      "glow": {
        "meaning": "Voltooid, unlocked, beloning, highlight",
        "from": "#FFD854",
        "to":   "#FFB07A",
        "ink":  "#B57A12",
        "wash": "#FFF6E0",
        "onColor": "#4A3200",
        "gradient": "linear-gradient(135deg, #FFD854, #FFB07A)"
      },
      "bloom": {
        "meaning": "Speciaal spoor, optionele content, AI-features, nieuw",
        "from": "#FF8AD8",
        "to":   "#C77DFF",
        "ink":  "#A5299B",
        "wash": "#FCEBFA",
        "onColor": "#3D0A38",
        "gradient": "linear-gradient(135deg, #FF8AD8, #C77DFF)"
      }
    },
    "neutral": {
      "canvas":   "#F5F6F9",
      "card":     "#FFFFFF",
      "cardSub":  "#F1F3F7",
      "layer":    "rgba(255,255,255,0.68)",
      "stroke":   "#E2E5EC",
      "strokeSoft": "#EBEDF2"
    },
    "text": {
      "ink":   "#1B1E28",
      "soft":  "#5C6272",
      "faint": "#9AA0AE"
    }
  },
  "radius": {
    "control": "4px",
    "card":    "8px",
    "large":   "12px",
    "pill":    "999px",
    "$note": "Fluent-conventie: controls 4px, kaarten/overlays 8px."
  },
  "shadow": {
    "elevation": "0 1px 2px rgba(27,30,40,.05), 0 6px 18px -10px rgba(27,30,40,.18)",
    "glowFlow":  "0 0 0 1px rgba(90,184,255,.35), 0 6px 22px -6px rgba(90,184,255,.60)",
    "glowGlow":  "0 0 0 1px rgba(255,176,122,.40), 0 6px 22px -6px rgba(255,184,90,.60)",
    "glowBloom": "0 0 0 1px rgba(199,125,255,.38), 0 6px 22px -6px rgba(255,138,216,.55)",
    "$note": "Glow-schaduwen vervangen de rand op betekenisvolle states. Elevation = rust."
  },
  "typography": {
    "fontFamily": "\"HK Grotesk\", \"Segoe UI Variable\", \"Segoe UI\", system-ui, sans-serif",
    "fallbackFree": "Hanken Grotesk",
    "scale": {
      "displayXL": { "size": "46px", "weight": 700, "tracking": "-0.03em", "line": 1.02 },
      "title":     { "size": "30px", "weight": 700, "tracking": "-0.02em", "line": 1.1 },
      "subtitle":  { "size": "20px", "weight": 600, "tracking": "-0.01em", "line": 1.25 },
      "bodyLarge": { "size": "18px", "weight": 400, "tracking": "0",       "line": 1.5 },
      "body":      { "size": "15px", "weight": 400, "tracking": "0",       "line": 1.5 },
      "label":     { "size": "12px", "weight": 600, "tracking": "0.12em",  "line": 1.3, "transform": "uppercase" },
      "caption":   { "size": "11px", "weight": 500, "tracking": "0.06em",  "line": 1.3 }
    }
  },
  "spacing": { "xs": "4px", "sm": "8px", "md": "14px", "lg": "22px", "xl": "34px", "2xl": "52px" },
  "ambient": {
    "$note": "Zachte glow-gradienten in de canvashoeken. Zet als background-image op de app-root.",
    "backgroundImage": "radial-gradient(700px 460px at 0% -8%, rgba(125,227,255,.20), transparent 60%), radial-gradient(760px 520px at 105% 4%, rgba(255,216,84,.14), transparent 55%), radial-gradient(680px 620px at 85% 108%, rgba(199,125,255,.13), transparent 60%)"
  },
  "motion": {
    "$note": "Expressive springs: fysica-gebaseerd, onderbreekbaar, natuurlijker dan duur+bezier. Overshoot respecteert prefers-reduced-motion.",
    "spring": {
      "snappy": {
        "use": "Knop, toggle, chip-selectie — kort en kwiek, geen overshoot",
        "framerMotion": { "type": "spring", "stiffness": 520, "damping": 34, "mass": 0.8 },
        "cssLinear": "linear(0, 0.24 4%, 0.66 10%, 0.9 16%, 1.0 24%, 1 100%)",
        "cssFallback": "180ms cubic-bezier(0.2, 0.8, 0.2, 1)"
      },
      "flow": {
        "use": "Node-selectie, kaart-hover, nav-strip naar actief item — lichte overshoot zodat de glow aanspringt",
        "framerMotion": { "type": "spring", "stiffness": 320, "damping": 26, "mass": 1 },
        "cssLinear": "linear(0, 0.18 4%, 0.55 9%, 0.9 15%, 1.06 22%, 1.02 30%, 1 44%, 1 100%)",
        "cssFallback": "280ms cubic-bezier(0.34, 1.3, 0.64, 1)"
      },
      "bloom": {
        "use": "Unlock, beloning, InfoBar-verschijning, node die vrijkomt — meer bounce, mag vieren",
        "framerMotion": { "type": "spring", "stiffness": 240, "damping": 18, "mass": 1.1 },
        "cssLinear": "linear(0, 0.14 4%, 0.5 9%, 0.94 15%, 1.12 21%, 1.14 25%, 1.02 34%, 0.98 42%, 1 54%, 1 100%)",
        "cssFallback": "420ms cubic-bezier(0.34, 1.56, 0.64, 1)"
      }
    },
    "reducedMotion": {
      "$note": "Bij prefers-reduced-motion: geen overshoot/bounce, korte lineaire overgang.",
      "transition": "120ms ease-out"
    }
  }
}
