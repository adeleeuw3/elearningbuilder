{
  "name": "observation-builder",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit -p apps/builder && tsc --noEmit -p apps/studio && tsc --noEmit -p packages/ui",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "pnpm --filter @ob/db migrate",
    "secret-scan": "node packages/exporter/dist/secret-scan.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.23.0",
    "eslint": "^9.9.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "zod-to-json-schema": "^3.23.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "autoprefixer": "^10.5.4",
    "next": "^15.5.22",
    "postcss": "^8.5.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.19",
    "zod": "^3.23.0"
  }
}
